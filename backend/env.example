# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── Security & Resilience Layer ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_AUTH=5
THROTTLE_LIMIT_PAYMENTS=10
THROTTLE_LIMIT_RESERVATIONS=15
THROTTLE_LIMIT_UPLOADS=10
REQUEST_TIMEOUT_MS=10000
MAX_JSON_BODY_SIZE=1mb
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REGISTRATIONS_PER_IP_DAY=3
MAX_PAGE_SIZE=100

# ─── Database ─────────────────────────────────────────────────────────────────
# Pooled (PgBouncer) — used at runtime
DATABASE_URL=postgresql://user:password@host:6543/db?pgbouncer=true&connection_limit=1

# Direct — used for Prisma Migrate
DIRECT_URL=postgresql://user:password@host:5432/db

# ─── Redis Infrastructure ──────────────────────────────────────────────────────
# Optional Redis connection URL (e.g. redis://localhost:6379 or rediss://user:pass@host:6379)
# If omitted or uncontactable, Tracking Gateway operates in In-Memory Fallback mode.
REDIS_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ─── Routing Engine ───────────────────────────────────────────────────────────
# OpenRouteService API key (free tier: 40 req/min)
# Get yours at: https://openrouteservice.org/dev/#/signup
# If not set, falls back to OSRM public server (bike profile)
OPENROUTESERVICE_API_KEY=

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# SUPABASE_URL        — Project URL (e.g. https://abc.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY — Secret key (never expose to frontend!)
# SUPABASE_BUCKET     — Storage bucket name (e.g. bikes)
#
# IMPORTANT: Only imageKey is stored in the database.
# The public URL is always constructed at runtime:
#   {SUPABASE_URL}/storage/v1/object/public/{SUPABASE_BUCKET}/{imageKey}
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=bikes
