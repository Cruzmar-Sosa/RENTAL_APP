generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String           @id @default(uuid())
  code              Int              @unique @default(autoincrement())
  email             String           @unique
  password          String
  name              String?
  phone             String?
  documentType      DocumentType?
  documentNumber    String?
  role              Role             @default(USER)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  payments          Payment[]
  reportedIncidents Reservation[]    @relation("IncidentReporter")
  reservations      Reservation[]
  permissions       UserPermission[]
}

model Permission {
  id            String           @id @default(uuid())
  module        String
  action        String
  type          String
  createdAt     DateTime         @default(now())
  roleAccess    RolePermission[]
  userOverrides UserPermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  allowed      Boolean
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Station {
  id        String    @id @default(uuid())
  code      Int       @unique @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  address   String?
  capacity  Int       @default(10)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  bikes     Bike[]
}

model Bike {
  id                String                @id @default(uuid())
  code              Int                   @unique @default(autoincrement())
  model             String?
  batteryLevel      Int                   @default(100)
  status            BikeStatus            @default(AVAILABLE)
  operationalStatus BikeOperationalStatus @default(AVAILABLE)
  technicalStatus   BikeTechnicalStatus   @default(OK)
  stationId         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  imageUrl          String?
  imageKey          String?
  station           Station?              @relation(fields: [stationId], references: [id])
  events            BikeEvent[]
  locations         BikeLocation[]
  reservations      Reservation[]
}

model BikeLocation {
  id        String   @id @default(uuid())
  bikeId    String
  latitude  Float
  longitude Float
  speed     Float    @default(0)
  timestamp DateTime @default(now())
  bike      Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)

  @@index([bikeId, timestamp])
}

model Reservation {
  id                   String                     @id @default(uuid())
  userId               String
  bikeId               String
  status               ReservationStatus          @default(CONFIRMED)
  financialStatus      ReservationFinancialStatus @default(PENDING)
  startTime            DateTime                   @default(now())
  endTime              DateTime?
  checkInAt            DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  settledAt            DateTime?
  expiresAt            DateTime?
  priceEstimated       Decimal?                   @db.Decimal(10, 2)
  priceActual          Decimal?                   @db.Decimal(10, 2)
  ratePerHour          Decimal?                   @default(50) @db.Decimal(10, 2)
  clientName           String?
  clientPhone          String?
  guestName            String?
  guestDocument        String?
  guestPhone           String?
  extras               Json?
  extrasTotal          Decimal?                   @default(0) @db.Decimal(10, 2)
  bikeCondition        String?
  bikeNotes            String?
  termsAccepted        Boolean?                   @default(false)
  incidentType         String?
  incidentCategory     String?
  incidentNotes        String?
  incidentReportedAt   DateTime?
  incidentReportedById String?
  settlementReference  String?                    @unique
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  payments             Payment[]
  bike                 Bike                       @relation(fields: [bikeId], references: [id])
  incidentReportedBy   User?                      @relation("IncidentReporter", fields: [incidentReportedById], references: [id])
  user                 User                       @relation(fields: [userId], references: [id])
  events               ReservationEvent[]

  @@index([status, financialStatus])
}

model Payment {
  id                    String        @id @default(uuid())
  reservationId         String
  userId                String
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  type                  PaymentType   @default(UPFRONT)
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  reservation           Reservation   @relation(fields: [reservationId], references: [id])
  user                  User          @relation(fields: [userId], references: [id])
}

model Route {
  id          String          @id @default(uuid())
  name        String
  description String?
  difficulty  RouteDifficulty @default(EASY)
  distanceKm  Float
  durationMin Int
  polyline    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  pois        POI[]
}

model POI {
  id          String   @id @default(uuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  routeId     String
  createdAt   DateTime @default(now())
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

model ReservationEvent {
  id                      String                      @id @default(uuid())
  reservationId           String
  previousStatus          ReservationStatus?
  nextStatus              ReservationStatus
  previousFinancialStatus ReservationFinancialStatus?
  nextFinancialStatus     ReservationFinancialStatus
  eventType               String
  metadata                Json?
  createdById             String?
  correlationId           String?
  timestamp               DateTime                    @default(now())
  reservation             Reservation                 @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([correlationId])
}

model PaymentEvent {
  id                String         @id @default(uuid())
  paymentId         String
  reservationId     String
  eventType         String
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("USD")
  provider          String?
  providerReference String?
  statusBefore      PaymentStatus?
  statusAfter       PaymentStatus
  metadata          Json?
  timestamp         DateTime       @default(now())

  @@index([paymentId])
  @@index([reservationId])
}

model BikeEvent {
  id                        String                 @id @default(uuid())
  bikeId                    String
  previousOperationalStatus BikeOperationalStatus?
  nextOperationalStatus     BikeOperationalStatus
  previousTechnicalStatus   BikeTechnicalStatus?
  nextTechnicalStatus       BikeTechnicalStatus
  eventType                 BikeEventType
  source                    BikeEventSource
  correlationId             String?
  metadata                  Json?
  createdById               String?
  timestamp                 DateTime               @default(now())
  bike                      Bike                   @relation(fields: [bikeId], references: [id], onDelete: Cascade)

  @@index([bikeId])
  @@index([correlationId])
}

enum DocumentType {
  DNI
  PASSPORT
  OTHER
}

enum Role {
  USER
  ADMIN
  INVITED
}

enum BikeStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
}

enum BikeOperationalStatus {
  AVAILABLE
  RESERVED
  CHECKED_IN
  IN_USE
}

enum BikeTechnicalStatus {
  OK
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  ACTIVE
  COMPLETED
  SETTLEMENT_PENDING
  SETTLED
  CANCELLED
  NO_SHOW
}

enum ReservationFinancialStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  UPFRONT
  DEPOSIT
  POST_RIDE
  BALANCE
  REFUND
}

enum RouteDifficulty {
  EASY
  MODERATE
  HARD
}

enum BikeEventType {
  OPERATIONAL_STATUS_CHANGED
  TECHNICAL_STATUS_CHANGED
  ASSIGNED_TO_STATION
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  AUTO_SYNC
}

enum BikeEventSource {
  LIFECYCLE
  ADMIN
  SYSTEM
  SETTLEMENT
  CRON
  SYNC_ENGINE
}
