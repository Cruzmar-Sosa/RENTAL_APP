generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH & PERMISSIONS
// ─────────────────────────────────────────────

model User {
  id           String           @id @default(uuid())
  code         Int              @unique @default(autoincrement())
  email        String           @unique
  password     String
  name         String?
  phone        String?
  documentType DocumentType?
  documentNumber String?
  role         Role             @default(USER)
  reservations Reservation[]
  permissions  UserPermission[]
  payments     Payment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
}

enum DocumentType {
  DNI
  PASSPORT
  OTHER
}

enum Role {
  USER
  ADMIN
  INVITED
}

model Permission {
  id            String           @id @default(uuid())
  module        String           // e.g., "BIKES", "USERS", "STATIONS"
  action        String           // e.g., "CREATE", "READ", "UPDATE", "DELETE", "PAGE"
  type          String           // "PAGE" or "ACTION"
  createdAt     DateTime         @default(now())
  roleAccess    RolePermission[]
  userOverrides UserPermission[]

  @@unique([module, action])
}


model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean

  @@unique([userId, permissionId])
}

// ─────────────────────────────────────────────
// STATIONS & BIKES
// ─────────────────────────────────────────────

model Station {
  id        String   @id @default(uuid())
  code      Int      @unique @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  address   String?
  capacity  Int      @default(10)
  bikes     Bike[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Bike {
  id           String         @id @default(uuid())
  code         Int            @unique @default(autoincrement())
  model        String?
  batteryLevel Int            @default(100) // percentage 0–100
  status       BikeStatus     @default(AVAILABLE)
  stationId    String?
  station      Station?       @relation(fields: [stationId], references: [id])
  reservations Reservation[]
  locations    BikeLocation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
}

enum BikeStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
}

model BikeLocation {
  id        String   @id @default(uuid())
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  speed     Float    @default(0) // km/h
  timestamp DateTime @default(now())

  @@index([bikeId, timestamp])
}

// ─────────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────────

model Reservation {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  bikeId         String
  bike           Bike              @relation(fields: [bikeId], references: [id])
  status         ReservationStatus @default(CONFIRMED)
  startTime      DateTime          @default(now())   // when reservation was created
  endTime        DateTime?                           // expected end (optional)
  actualStart    DateTime?                           // when ride actually started
  actualEnd      DateTime?                           // when ride actually ended
  expiresAt      DateTime?                           // expiration for PENDING reservations
  priceEstimated Float?                              // calculated on create
  priceActual    Float?                              // calculated on complete

  // ── Pricing ──
  ratePerHour    Float?            @default(50)      // editable rate at creation

  // ── Guest / Client snapshot (decoupled from auth user) ──
  clientName     String?                              // may differ from user.name
  clientPhone    String?                              // snapshot at reservation time
  guestName      String?                              // for walk-in / non-registered clients
  guestDocument  String?                              // guest document number
  guestPhone     String?                              // guest phone

  // ── Extras (snapshot — immutable after creation) ──
  extras         Json?                                // [{name:"Helmet",price:10},...]
  extrasTotal    Float?            @default(0)

  // ── Check-in (set at Start Ride) ──
  bikeCondition  String?                              // GOOD | REGULAR | DAMAGED
  bikeNotes      String?                              // free-text notes
  termsAccepted  Boolean?          @default(false)

  // ── Settlement / Incidents ──
  incidentType   String?                              // MECHANICAL | TECHNICAL | OTHER
  incidentNotes  String?                              // free-text

  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE      // ride in progress
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id                   String        @id @default(uuid())
  reservationId        String        
  reservation          Reservation   @relation(fields: [reservationId], references: [id])
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  amount               Float
  currency             String        @default("USD")
  type                 PaymentType   @default(UPFRONT)
  status               PaymentStatus @default(PENDING)
  stripePaymentIntentId String?      // Ready for Stripe integration
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  UPFRONT
  DEPOSIT
  POST_RIDE
  BALANCE    // post-ride debt when actual > estimated
  REFUND     // refund issued due to incident
}

// ─────────────────────────────────────────────
// ROUTES & POI
// ─────────────────────────────────────────────

model Route {
  id          String     @id @default(uuid())
  name        String
  description String?
  difficulty  RouteDifficulty @default(EASY)
  distanceKm  Float
  durationMin Int        // estimated minutes
  polyline    Json?      // array of {lat, lng} points — ready for Google Maps
  pois        POI[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum RouteDifficulty {
  EASY
  MODERATE
  HARD
}

model POI {
  id          String   @id @default(uuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
