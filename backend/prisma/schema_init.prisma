generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bike {
  id          String        @id
  status      BikeStatus    @default(AVAILABLE)
  stationId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Station     Station?      @relation(fields: [stationId], references: [id])
  Reservation Reservation[]
}

model Reservation {
  id        String            @id
  userId    String
  bikeId    String
  status    ReservationStatus @default(ACTIVE)
  startTime DateTime          @default(now())
  endTime   DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime
  Bike      Bike              @relation(fields: [bikeId], references: [id])
  User      User              @relation(fields: [userId], references: [id])
}

model Station {
  id        String   @id
  name      String
  latitude  Float
  longitude Float
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Bike      Bike[]
}

model User {
  id          String        @id
  email       String        @unique
  password    String
  name        String?
  role        Role          @default(USER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Reservation Reservation[]
}

enum BikeStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}
